<Window x:Class="Mp3Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mp3Player"
        Title="MP3 Player" Height="839" Width="1202"
        WindowStyle="None" ResizeMode="NoResize" Background="#1f1f1f" FontFamily="Courier New">
    <Window.Resources>

        <!-- Brushed metal background simulation (tile of thin lines) -->
        <DrawingBrush x:Key="BrushedMetalBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#222222">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1f1f1f" Offset="0" />
                                <GradientStop Color="#2b2b2b" Offset="0.5" />
                                <GradientStop Color="#1f1f1f" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,1" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Thickness="1" Brush="#151515" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Header brush to give a metallic sheen on group headers -->
        <LinearGradientBrush x:Key="MetalHeaderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#333333" Offset="0" />
            <GradientStop Color="#222222" Offset="0.5" />
            <GradientStop Color="#1a1a1a" Offset="1" />
        </LinearGradientBrush>

        <!-- LED glow effect resource used dynamically by styles -->
        <DropShadowEffect x:Key="LedGlowEffect" Color="#88FF66" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
        <!-- red LED glow for clipping indicator -->
        <DropShadowEffect x:Key="LedGlowEffectRed" Color="#FF4444" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />

        <RadialGradientBrush x:Key="LedOffBrushRed" GradientOrigin="0.35,0.35" Center="0.4,0.4">
            <GradientStop Color="#220000" Offset="0" />
            <GradientStop Color="#330000" Offset="0.6" />
            <GradientStop Color="#000000" Offset="1" />
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="LedOnBrushRed" GradientOrigin="0.35,0.35" Center="0.4,0.4">
            <GradientStop Color="#FF6666" Offset="0" />
            <GradientStop Color="#FF2222" Offset="0.7" />
            <GradientStop Color="#440000" Offset="1" />
        </RadialGradientBrush>

        <!-- GroupBox header style with brushed metal background -->
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border BorderBrush="#444" BorderThickness="1" Background="{StaticResource BrushedMetalBrush}" CornerRadius="4" Padding="6" SnapsToDevicePixels="True">
                            <DockPanel>
                                <Border Background="{StaticResource MetalHeaderBrush}" DockPanel.Dock="Top" CornerRadius="3" Padding="6" Margin="0,0,0,6">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                </Border>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Big rectangular button with small oval indicator - refined for retro HiFi look -->
        <Style x:Key="BigButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#F7F7E8" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border" CornerRadius="6" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2B2B2B" Offset="0" />
                                        <GradientStop Color="#121212" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#666" Offset="0" />
                                        <GradientStop Color="#111" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Grid Margin="8,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- small indicator LED -->
                            <Ellipse x:Name="Indicator" Width="12" Height="8" Fill="#223322" Stroke="#001100" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- subtle bevel/highlight overlay -->
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.12" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.Opacity>0.06</Rectangle.Opacity>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.35" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Indicator" Property="Fill" Value="#558844" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Indicator" Property="Fill" Value="#88FF66" />
                            </Trigger>
                            <Trigger Property="local:IndicatorHelper.IsIndicatorOn" Value="True">
                                <Setter TargetName="Indicator" Property="Fill" Value="#88FF66" />
                                <Setter TargetName="Indicator" Property="Effect" Value="{StaticResource LedGlowEffect}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="PulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:0.8" />
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="RenderTransform.ScaleX" From="1.0" To="1.15" Duration="0:0:0.8" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monochrome display TextBox style (retro green CRT look) -->
        <Style x:Key="MonoDisplayTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0b2a0b" />
            <Setter Property="Foreground" Value="#A7F07B" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="#224400" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="4,2" />
                                <Rectangle IsHitTestVisible="False" Stroke="#113311" StrokeThickness="1" Opacity="0.12" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Power button style (red indicator) - compact variant of BigButtonStyle -->
        <Style x:Key="PowerButtonStyle" TargetType="Button" BasedOn="{StaticResource BigButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border" CornerRadius="5" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2A2A2A" Offset="0" />
                                        <GradientStop Color="#111" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#333" />
                                </Border.BorderBrush>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2" />
                            </Border>
                            <Ellipse x:Name="Indicator" Width="10" Height="6" Fill="#442222" Stroke="#220000" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.25" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Indicator" Property="Fill" Value="#884444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Indicator" Property="Fill" Value="#FF6666" />
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="local:IndicatorHelper.IsIndicatorOn" Value="True">
                                <Setter TargetName="Indicator" Property="Fill" Value="#FF4444" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:0.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider thumb sizing for main sliders (textured metal knob) -->
        <Style x:Key="LargeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Border CornerRadius="3" BorderThickness="1" BorderBrush="#333">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#E6E6E6" Offset="0" />
                                        <GradientStop Color="#BBBBBB" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle Margin="2" RadiusX="2" RadiusY="2" Stroke="#8A8A8A" Fill="#00000000" Opacity="0.12" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible corner resize grips -->
        <Style x:Key="InvisibleCornerThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Track list item styling -->
        <Style x:Key="TrackListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#A7F07B" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Converter for toggles visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215*"/>
            <ColumnDefinition Width="1229*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="RootGrid" Margin="10" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <!-- start collapsed (width 0) so right panel doesn't appear empty on first open -->
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Track list -->
            <GroupBox Header="Track List" Grid.Column="0" Margin="4" Foreground="White">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="4">
                        <Button Name="BtnSelectFolder" Click="BtnSelectFolder_Click" Width="120">Select Folder</Button>
                        <TextBlock Name="TxtFolder" Margin="8,4" VerticalAlignment="Center" TextWrapping="Wrap" />

                    </StackPanel>
                    <ListBox Name="ListTracks" Margin="4" MouseDoubleClick="ListTracks_MouseDoubleClick" SelectionChanged="ListTracks_SelectionChanged" ItemContainerStyle="{StaticResource TrackListItemStyle}" />
                </DockPanel>
            </GroupBox>

            <!-- Player and visualizer -->
            <!-- Title bar / drag area around main player -->
            <Border Grid.Column="1" Margin="8" Background="#222" CornerRadius="6" Padding="6" x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <TextBlock Text="Retro HiFi" Foreground="#A7F07B" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- decorative LEDs -->
                        <Ellipse Width="8" Height="6" Fill="#113311" Stroke="#002200" Margin="6,0" />
                        <Ellipse Width="8" Height="6" Fill="#113311" Stroke="#002200" Margin="6,0" />
                        <Ellipse Width="8" Height="6" Fill="#113311" Stroke="#002200" Margin="6,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Right-side Manage Audio Files panel -->
            <GroupBox Name="ManageAudioGroup" Header="Manage Audio Files" Grid.Column="2" Margin="4" Visibility="Collapsed" Foreground="White">
                <StackPanel Margin="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Name="RbEnableManage" Content="Enable Manage Mode" Foreground="White" Checked="RbEnableManage_Checked" Unchecked="RbEnableManage_Unchecked" />
                        <TextBlock Name="TxtManageWarning" Foreground="DarkRed" Margin="8,0,0,0" Visibility="Collapsed">Warning: enabling will allow permanent file operations</TextBlock>
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Selected file:" FontWeight="Bold" Foreground="White" />
                        <TextBlock Name="TxtSelectedFile" Text="(none)" Margin="0,4" Foreground="White" />
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <Button Name="BtnRename" Click="BtnRename_Click" Style="{StaticResource BigButtonStyle}" IsEnabled="False">Rename</Button>
                            <Button Name="BtnDelete" Click="BtnDelete_Click" Style="{StaticResource BigButtonStyle}" Margin="6,0" IsEnabled="False">Delete</Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBox Name="TxtRename" Width="180" IsEnabled="False" Foreground="White" Background="#333" />
                            <Button Name="BtnApplyRename" Click="BtnRename_Click" Style="{StaticResource BigButtonStyle}" Margin="6,0">Apply</Button>
                        </StackPanel>
                        <TextBlock Name="TxtMarkedNotice" Foreground="Yellow" Visibility="Collapsed" Margin="0,6" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <Border Grid.Column="1" Margin="8" Background="#2b2b2b" Padding="8">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- BtnToggleList moved into MP3 Player deck (bottom-left of that deck) -->
                        <Button Name="BtnToggleAudio" Click="BtnToggleAudio_Click" Width="28" Height="28" HorizontalAlignment="Right" Grid.Column="2">⚙</Button>
                    </Grid>
                    <Border x:Name="MainPlayerBorder" BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4" MouseLeftButtonDown="MainPlayerBorder_MouseLeftButtonDown">
                        <Grid>
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <!-- playback controls -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- VU meters -->
                                        <ColumnDefinition Width="160" />
                                        <!-- volume and other right controls -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Playback controls moved to MP3 Player deck below; keep VU meters and right controls here -->
                                    <!-- VU meters (Left / Right) between playback and volume controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                                        <!-- Left rectangular VU (white rectangle display). Mount point below visible area (not shown). -->
                                        <Border Background="White" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2,0" Height="44" Width="76">
                                            <Grid>
                                                <!-- canvas taller than visible rectangle so mount point can be below -->
                                                <Canvas Width="80" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas.Clip>
                                                        <RectangleGeometry Rect="6,6,68,44" />
                                                    </Canvas.Clip>
                                                    <!-- visible meter face (rectangle) positioned at top of canvas -->
                                                    <Rectangle Canvas.Left="6" Canvas.Top="6" Width="68" Height="44" Fill="White" Stroke="#eee" RadiusX="3" RadiusY="3" />
                                                    <!-- realistic backlight glow (warm) under needle, above face -->
                                                    <Ellipse Canvas.Left="12" Canvas.Top="20" Width="56" Height="28" Opacity="0.9">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush GradientOrigin="0.5,0.8" Center="0.5,0.8" RadiusX="0.6" RadiusY="0.5">
                                                                <GradientStop Color="#FFFFF4" Offset="0" />
                                                                <GradientStop Color="#FFF0D0" Offset="0.4" />
                                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="12" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <!-- needle: pivot (mount) is below the visible rectangle at (40,56) and is not drawn -->
                                                    <Line X1="40" Y1="56" X2="40" Y2="22" Stroke="#FF4444" StrokeThickness="2" StrokeEndLineCap="Round">
                                                        <Line.RenderTransform>
                                                            <RotateTransform x:Name="NeedleLeftRotate" Angle="-45" CenterX="40" CenterY="56" />
                                                        </Line.RenderTransform>
                                                    </Line>
                                                    <!-- static background VU scale (labels and ticks) -->
                                                    <Line X1="14" Y1="20" X2="14" Y2="26" Stroke="#888" StrokeThickness="1" />
                                                    <TextBlock Canvas.Left="6" Canvas.Top="8" Text="-20" FontSize="9" Foreground="#666" Width="20" TextAlignment="Center" />
                                                    <Line X1="40" Y1="18" X2="40" Y2="28" Stroke="#888" StrokeThickness="1" />
                                                    <TextBlock Canvas.Left="32" Canvas.Top="8" Text="-10" FontSize="9" Foreground="#666" Width="20" TextAlignment="Center" />
                                                    <Line X1="66" Y1="20" X2="66" Y2="26" Stroke="#888" StrokeThickness="1" />
                                                    <TextBlock Canvas.Left="58" Canvas.Top="8" Text="0" FontSize="9" Foreground="#666" Width="20" TextAlignment="Center" />
                                                </Canvas>
                                            </Grid>
                                        </Border>

                                        <!-- Right rectangular VU (white rectangle display). Mount point below visible area (not shown). -->
                                        <Border Background="White" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2,0" Height="44" Width="76">
                                            <Grid>
                                                <Canvas Width="80" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas.Clip>
                                                        <RectangleGeometry Rect="6,6,68,44" />
                                                    </Canvas.Clip>
                                                    <Rectangle Canvas.Left="6" Canvas.Top="6" Width="68" Height="44" Fill="White" Stroke="#eee" RadiusX="3" RadiusY="3" />
                                                    <!-- realistic backlight glow (warm) under needle, above face -->
                                                    <Ellipse Canvas.Left="12" Canvas.Top="20" Width="56" Height="28" Opacity="0.9">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush GradientOrigin="0.5,0.8" Center="0.5,0.8" RadiusX="0.6" RadiusY="0.5">
                                                                <GradientStop Color="#FFFFF4" Offset="0" />
                                                                <GradientStop Color="#FFF0D0" Offset="0.4" />
                                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="12" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Line X1="40" Y1="56" X2="40" Y2="22" Stroke="#FF4444" StrokeThickness="2" StrokeEndLineCap="Round">
                                                        <Line.RenderTransform>
                                                            <RotateTransform x:Name="NeedleRightRotate" Angle="-45" CenterX="40" CenterY="56" />
                                                        </Line.RenderTransform>
                                                    </Line>
                                                    <!-- static background VU scale (labels and ticks) -->
                                                    <Line X1="14" Y1="20" X2="14" Y2="26" Stroke="#888" StrokeThickness="1" />
                                                    <TextBlock Canvas.Left="6" Canvas.Top="8" Text="-20" FontSize="9" Foreground="#666" Width="20" TextAlignment="Center" />
                                                    <Line X1="40" Y1="18" X2="40" Y2="28" Stroke="#888" StrokeThickness="1" />
                                                    <TextBlock Canvas.Left="32" Canvas.Top="8" Text="-10" FontSize="9" Foreground="#666" Width="20" TextAlignment="Center" />
                                                    <Line X1="66" Y1="20" X2="66" Y2="26" Stroke="#888" StrokeThickness="1" />
                                                    <TextBlock Canvas.Left="58" Canvas.Top="8" Text="0" FontSize="9" Foreground="#666" Width="20" TextAlignment="Center" />
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,0,0">
                                        <TextBlock Text="Volume" VerticalAlignment="Center" Margin="8,0" Foreground="White" />
                    <Slider Name="SliderVolume" Minimum="0" Maximum="1" Value="0.8" Width="160" ValueChanged="SliderVolume_ValueChanged" Height="24">
                        <Slider.Resources>
                            <Style TargetType="Thumb" BasedOn="{StaticResource LargeThumbStyle}" />
                        </Slider.Resources>
                    </Slider>
                    <!-- Clipping indicator: red LED bulb (fixed size). Uses radial brushes and glow effect when lit.
                         Keep visible so it does not affect layout when toggled; use opacity to indicate off state. -->
                    <Ellipse Name="ClipIndicator" Width="16" Height="16" Fill="{StaticResource LedOffBrushRed}" Stroke="#330000" StrokeThickness="1" Margin="8,0" VerticalAlignment="Center" Visibility="Visible" Opacity="0.18" />
                                        <!-- Maximize/Restore button -->
                                        <Button Name="BtnMaxRestore" Click="BtnMaxRestore_Click" Style="{StaticResource BigButtonStyle}" Width="48" Height="32" Margin="6,0">▢</Button>
                                        <Button Name="BtnPower" Click="BtnPower_Click" Style="{StaticResource PowerButtonStyle}" Margin="6,0">⏻</Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress slider moved to MP3 Player deck below -->

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MP3 Player deck (playback controls moved here) -->
                    <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                        <Grid>
                            <ToggleButton x:Name="ToggleMp3Deck" Width="32" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Content="▾" ToolTip="Toggle MP3 Player Deck" />
                            <TextBlock Text="MP3 Player" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        </Grid>
                        <Border Background="#1b1b1b" Padding="8" Margin="0,6,0,0" Visibility="{Binding IsChecked, ElementName=ToggleMp3Deck, Converter={StaticResource BoolToVis}}" CornerRadius="4" BorderBrush="#333" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>
                                <!-- Playback controls -->
                                <UniformGrid Columns="3" Rows="1" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="0">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource BigButtonStyle}" Name="BtnPrev" Click="BtnPrev_Click" Margin="6">◀</Button>
                                        <TextBlock Text="Prev" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource BigButtonStyle}" Name="BtnPlayPause" Click="BtnPlayPause_Click" Margin="6">Play</Button>
                                        <TextBlock Text="Play / Pause" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource BigButtonStyle}" Name="BtnNext" Click="BtnNext_Click" Margin="6">▶</Button>
                                        <TextBlock Text="Next" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Progress slider -->
                                <Grid Margin="4" Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Height="4" VerticalAlignment="Center" Fill="#444" RadiusX="2" RadiusY="2" />
                                    <Slider Name="SliderProgress" Minimum="0" Maximum="1" ValueChanged="SliderProgress_ValueChanged" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="30" Grid.Column="0" PreviewMouseLeftButtonDown="SliderProgress_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SliderProgress_PreviewMouseLeftButtonUp">
                                        <Slider.Resources>
                                            <Style TargetType="Thumb" BasedOn="{StaticResource LargeThumbStyle}" />
                                        </Slider.Resources>
                                    </Slider>
                                </Grid>

                                <!-- Bottom row: moved BtnToggleList to bottom-left of the deck -->
                                <Grid Grid.Row="2">
                                    <Button Name="BtnToggleList" Click="BtnToggleList_Click" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">☰</Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Radio and YouTube decks follow -->
                        <!-- Radio deck -->
                        <Grid>
                            <ToggleButton x:Name="ToggleRadioDeck" Width="32" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Content="▾" ToolTip="Toggle Radio Deck" />
                            <TextBlock Text="Radio" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        </Grid>
                        <Border Background="#1b1b1b" Padding="8" Margin="0,6,0,0" Visibility="{Binding IsChecked, ElementName=ToggleRadioDeck, Converter={StaticResource BoolToVis}}" CornerRadius="4" BorderBrush="#333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtRadioStationName" Text="(no station)" Foreground="White" FontWeight="Bold" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button x:Name="BtnScanBack" Width="44" Height="28" Click="BtnScanBack_Click">◀◀</Button>
                                    <!-- Horizontal vintage tuner -->
                                    <Border Width="800" Height="80" Background="#101010" BorderBrush="#444" BorderThickness="1" Margin="12,0" CornerRadius="4">
                                        <Grid>
                                            <!-- Frequency labels and ticks will be drawn into this canvas at runtime -->
                                            <Canvas x:Name="TunerCanvas" Margin="8">
                                                <!-- Red indicator line (vertical line over horizontal track) placed inside canvas -->
                                                <Rectangle x:Name="TunerIndicator" Width="3" Height="64" Fill="#FF3333" />
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="BtnScanForward" Width="44" Height="28" Click="BtnScanForward_Click">▶▶</Button>
                                </StackPanel>
                                <TextBlock x:Name="TxtRadioFrequency" Text="-- MHz" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- YouTube deck -->
                        <Grid Margin="0,8,0,0">
                            <ToggleButton x:Name="ToggleYoutubeDeck" Width="32" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Content="▾" ToolTip="Toggle YouTube Deck" />
                            <TextBlock Text="YouTube" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        </Grid>
                        <Border Background="#1b1b1b" Padding="8" Margin="0,6,0,0" Visibility="{Binding IsChecked, ElementName=ToggleYoutubeDeck, Converter={StaticResource BoolToVis}}" CornerRadius="4" BorderBrush="#333" BorderThickness="1">
                            <!-- Placeholder YouTube UI -->
                            <StackPanel>
                                <TextBlock Text="YouTube player area (placeholder)" Foreground="White" />
                                <!-- future YouTube controls / webview go here -->
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Track info - monochrome LCD style -->
                    <Border Name="TrackInfoBorder" Background="#A7F07B" CornerRadius="4" BorderBrush="#224400" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Name="TxtTrackName" FontFamily="Consolas" FontWeight="Bold" Foreground="#001100" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Status:" FontWeight="Bold" Foreground="#001100" />
                                <TextBlock Name="TxtPlayStatus" Margin="6,0" Foreground="#001100" />
                                <TextBlock Text="  Volume:" FontWeight="Bold" Margin="12,0" Foreground="#001100" />
                                <TextBlock Name="TxtVolumeLevel" Margin="6,0" Foreground="#001100" />
                                <TextBlock Text="  " />
                                <TextBlock Text="Time:" FontWeight="Bold" Margin="12,0" Foreground="#001100" />
                                <TextBlock Name="TxtTimeInfo" Margin="6,0" Foreground="#001100" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <GroupBox Header="Spectrum Analyzer" Margin="0,8,0,0" Foreground="White">
                        <Canvas Name="SpectrumCanvas" Height="150" Background="Black" HorizontalAlignment="Stretch" ClipToBounds="True" />
                        <!-- Patch placeholder: no-op insertion to aid future patches -->
                    </GroupBox>

                    <GroupBox Name="AudioSettingsGroup" Header="Audio Settings" Margin="0,8,0,0" Foreground="White">
                        <ScrollViewer Height="300">
                            <StackPanel>
                                <!-- Reworked audio settings layout: EQ (3/4) on the left, Effects (1/4) on the right -->
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <!-- Give more room to the effects panel to avoid UI overlap -->
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- EQ panel -->
                                    <Border Grid.Column="0" Padding="8" Margin="4" Background="#252525" CornerRadius="4" BorderBrush="#3a3a3a" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Equalizer" FontWeight="Bold" Foreground="White" />
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="200" Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="6" HorizontalAlignment="Center">
                                                    <StackPanel.Resources>
                                                        <!-- apply textured thumb to sliders inside EQ panel -->
                                                        <Style TargetType="Thumb" BasedOn="{StaticResource LargeThumbStyle}" />
                                                    </StackPanel.Resources>
                                                    <!-- 15 vertical band sliders with textured thumbs -->
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band0" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="25 Hz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band1" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="40 Hz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band2" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="63 Hz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band3" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="100 Hz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band4" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="160 Hz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>

                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band5" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="250 Hz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band6" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="400 Hz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band7" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="630 Hz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band8" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="1 kHz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band9" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="1.6 kHz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>

                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band10" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="2.5 kHz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band11" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="4 kHz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band12" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="6.3 kHz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band13" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="10 kHz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                    <StackPanel Margin="6" HorizontalAlignment="Center">
                                                        <Slider Name="Band14" Orientation="Vertical" Height="140" Width="34" Minimum="-12" Maximum="12" Value="0" ValueChanged="EqBand_ValueChanged" />
                                                        <TextBlock Text="16 kHz" HorizontalAlignment="Center" Foreground="White" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <!-- Effects panel split into two columns: left = Echo/Reverb/Stereo, right = Bass/Treble -->
                                    <Border Grid.Column="1" Padding="8" Margin="4" Background="#222" CornerRadius="4" BorderBrush="#3a3a3a" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <TextBlock Text="Effects" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left column: existing effects -->
                                                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,6">
                                                        <Button Name="BtnEcho" Style="{StaticResource BigButtonStyle}" Click="EffectToggled" Width="90">Echo</Button>
                                                        <Slider Name="SliderEcho" Minimum="0" Maximum="1" Value="0" Width="120" ValueChanged="SliderEcho_ValueChanged" IsEnabled="False" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,6">
                                                        <Button Name="BtnReverb" Style="{StaticResource BigButtonStyle}" Click="EffectToggled" Width="90">Reverb</Button>
                                                        <Slider Name="SliderReverb" Minimum="0" Maximum="1" Value="0" Width="120" ValueChanged="SliderReverb_ValueChanged" IsEnabled="False" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,6">
                                                        <Button Name="BtnStereo" Style="{StaticResource BigButtonStyle}" Click="EffectToggled" Width="90">Stereo</Button>
                                                        <Slider Name="SliderStereo" Minimum="0" Maximum="1" Value="0" Width="120" ValueChanged="SliderStereo_ValueChanged" IsEnabled="False" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right column: Bass and Treble boosts with button + slider UI to match other effects -->
                                                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,6">
                                                        <Button Name="BtnBass" Style="{StaticResource BigButtonStyle}" Click="EffectToggled" Width="90">Bass</Button>
                                                        <Slider Name="SliderBass" Minimum="0" Maximum="1" Value="0" Width="120" ValueChanged="SliderBass_ValueChanged" IsEnabled="False" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,6">
                                                        <Button Name="BtnTreble" Style="{StaticResource BigButtonStyle}" Click="EffectToggled" Width="90">Treble</Button>
                                                        <Slider Name="SliderTreble" Minimum="0" Maximum="1" Value="0" Width="120" ValueChanged="SliderTreble_ValueChanged" IsEnabled="False" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Invisible corner resize handles -->
        <Thumb Name="ThumbTopLeft" Style="{StaticResource InvisibleCornerThumbStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="ThumbTopLeft_DragDelta" Panel.ZIndex="1000" />
        <Thumb Name="ThumbTopRight" Style="{StaticResource InvisibleCornerThumbStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="ThumbTopRight_DragDelta" Panel.ZIndex="1000" Grid.Column="1" />
        <Thumb Name="ThumbBottomLeft" Style="{StaticResource InvisibleCornerThumbStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="ThumbBottomLeft_DragDelta" Panel.ZIndex="1000" />
        <Thumb Name="ThumbBottomRight" Style="{StaticResource InvisibleCornerThumbStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ThumbBottomRight_DragDelta" Panel.ZIndex="1000" Grid.Column="1" />
    </Grid>
</Window>
